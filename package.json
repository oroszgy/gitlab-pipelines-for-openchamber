{
  "name": "@ec/gitlab-pipelines",
  "version": "0.5.0",
  "private": true,
  "description": "Read-only OpenChamber panel showing GitLab CI/CD pipelines for the open project.",
  "type": "module",
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun test",
    "test": "bun run build && bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/bun": "1.3.14",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "typescript": "^5.9.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "gitlab-pipelines",
        "name": "Pipelines",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "capabilities": [
        "files",
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "integration": {
        "name": "GitLab",
        "description": "Reads CI/CD pipelines, jobs and logs from one GitLab project. Read-only.",
        "token": {
          "apiOrigin": "https://sdlc.webcloud.ec.europa.eu",
          "scheme": "bearer",
          "account": {
            "path": "/api/v4/user",
            "name": "username"
          }
        },
        "settings": [
          {
            "id": "project",
            "label": "GitLab project path or ID (optional)"
          },
          {
            "id": "host",
            "label": "GitLab host (optional)"
          },
          {
            "id": "token",
            "label": "Access token"
          }
        ]
      }
    }
  }
}
