{
  "name": "gitlab-pipelines",
  "version": "0.10.1",
  "private": false,
  "description": "OpenChamber panel showing GitLab CI/CD pipelines for the open project, with capability-gated pipeline actions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oroszgy/gitlab-pipelines-for-openchamber.git"
  },
  "homepage": "https://github.com/oroszgy/gitlab-pipelines-for-openchamber#readme",
  "bugs": {
    "url": "https://github.com/oroszgy/gitlab-pipelines-for-openchamber/issues"
  },
  "keywords": [
    "openchamber",
    "gitlab",
    "pipelines",
    "ci",
    "extension"
  ],
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun test",
    "test": "bun run build && bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/bun": "1.3.14",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "typescript": "^5.9.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "gitlab-pipelines",
        "name": "GitLab Pipelines",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "capabilities": [
        "files",
        "sessions",
        "prompt"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
