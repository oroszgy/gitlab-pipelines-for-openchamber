{
  "name": "@ec/gitlab-pipelines",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only OpenChamber panel showing GitLab CI/CD pipelines for the open project.",
  "type": "module",
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/bun": "1.3.14",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=1.22.0" },
    "contributes": {
      "panel": {
        "id": "gitlab-pipelines",
        "name": "Pipelines",
        "icon": "gitlab-fill",
        "entry": "panel/index.html"
      },
      "capabilities": ["files", "sessions"],
      "integration": {
        "name": "GitLab",
        "description": "Reads CI/CD pipelines, jobs and logs from one GitLab project. Read-only.",
        "token": {
          "apiOrigin": "https://sdlc.webcloud.ec.europa.eu",
          "scheme": "bearer",
          "account": { "path": "/api/v4/user", "name": "username" }
        },
        "settings": [
          { "id": "project", "label": "GitLab project path or ID (optional)" }
        ]
      }
    }
  }
}
